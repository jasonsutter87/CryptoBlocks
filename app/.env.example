# CryptoBlocks — environment variables
# Copy to `.env` and fill in. See comments for what breaks when unset.

# --- Frontend (Vite) ---
VITE_CLERK_PUBLISHABLE_KEY=
VITE_ADMIN_EMAILS=
VITE_PARTYKIT_HOST=

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_ALLOW_UNSIGNED=

# --- Database (Turso / libSQL) ---
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=
STRIPE_TEACHER_PRODUCT_ID=
STRIPE_STUDENT_PRODUCT_ID=

# --- Admin ---
ADMIN_EMAILS=

# --- CORS ---
ALLOWED_ORIGINS=

# --- Process ---
NODE_ENV=
