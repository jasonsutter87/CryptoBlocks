# CryptoBlocks — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or set in Netlify dashboard for prod) and fill in.
# Every var here is referenced somewhere in app/netlify/functions/ or app/src/.
# Anything marked REQUIRED-PROD will silently break in production if unset.
# ---------------------------------------------------------------------------


# ============================================================================
# Frontend (Vite) — must be prefixed VITE_ to be exposed to the browser
# ============================================================================

# Clerk publishable key. Found at clerk.com → API Keys.
# REQUIRED — without it sign-in is broken everywhere.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated email allowlist for the /admin route (frontend gate).
# Mirror this in ADMIN_EMAILS below for the API gate.
# REQUIRED — without it admin panel is empty for everyone, including you.
VITE_ADMIN_EMAILS=you@example.com

# PartyKit host for real-time collab. Defaults to localhost in dev.
# REQUIRED-PROD — collab silently falls back to "no peers" if wrong host.
VITE_PARTYKIT_HOST=cryptoblocks.you.partykit.dev


# ============================================================================
# Backend (Netlify Functions)
# ============================================================================

# --- Clerk ---

# Clerk Backend API key. Used to look up user profile from sub claim.
# REQUIRED — without it the API treats every authed user as anonymous.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk JWKS endpoint for verifying session token signatures.
# REQUIRED — without it the API falls back to UNSIGNED token decode (only
# allowed when CLERK_ALLOW_UNSIGNED=true). Get from Clerk dashboard.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Issuer claim binding. Rejects tokens from other Clerk tenants signed by
# the same JWKS endpoint. Set to your Clerk instance URL.
# RECOMMENDED — without it, a token from staging/another project would
# validate against this deployment.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Dev escape hatch: skip signature verification when JWKS isn't reachable.
# Set to "true" only on local dev. Anything else (including unset) → off.
# DO NOT enable in prod — defeats the whole auth model.
CLERK_ALLOW_UNSIGNED=

# --- Database (Turso / libSQL) ---

# Turso database URL — `libsql://your-db.turso.io`.
# REQUIRED — every API endpoint returns 500 "Database not configured" without it.
TURSO_URL=libsql://your-db.turso.io

# Turso auth token from the Turso dashboard. Treat as a password.
# REQUIRED — see TURSO_URL.
TURSO_AUTH_TOKEN=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stripe ---

# Stripe secret key (sk_live_... in prod, sk_test_... in dev).
# REQUIRED-PROD for /api/stripe/* endpoints. Without it: 500 from those routes.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (whsec_...).
# REQUIRED-PROD — without it the webhook returns 400 to every Stripe event,
# so subscription state stops syncing.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe product IDs — used by buildLineItems AND by the webhook to derive
# plan from the signed subscription.items[].price.product. Defaults in
# stripe.mts are placeholder IDs from dev — override per environment.
# RECOMMENDED — without override, paid checkouts will fail OR map to the
# wrong plan in the webhook.
STRIPE_PRODUCT_ID=prod_xxxxxxxxxxxxxx          # the "pro" plan
STRIPE_TEACHER_PRODUCT_ID=prod_xxxxxxxxxxxxxx  # the "teacher" plan
STRIPE_STUDENT_PRODUCT_ID=prod_xxxxxxxxxxxxxx  # per-seat add-on for teacher plan

# --- Backend admin gate ---

# Mirror of VITE_ADMIN_EMAILS for the API allowlist (the frontend value
# can't be trusted server-side since it's bundled and visible to all users).
# REQUIRED for /api/admin/* — without it, admin endpoints reject everyone
# with 403.
ADMIN_EMAILS=you@example.com

# --- CORS ---

# Comma-separated list of origins allowed to call the API with credentials.
# Defaults baked into _lib/http.ts cover production + localhost dev ports;
# override only if you front the API from a different domain.
# RECOMMENDED-PROD — set explicitly so you control the exact list.
ALLOWED_ORIGINS=https://cryptoblocks.app,https://www.cryptoblocks.app

# --- Process ---

# Standard Node env. errorResponse() includes detail messages when this is
# anything other than "production". Netlify preview deploys typically don't
# set this — verify in netlify.toml.
NODE_ENV=development
